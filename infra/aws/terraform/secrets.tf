# The DB password is generated by Terraform (never typed by a human, never
# committed anywhere) and stored in Secrets Manager. ECS task definitions reference
# it by ARN via the `secrets` block (not as a plaintext environment variable), so it
# never appears in the task definition JSON, CloudWatch Logs, or `terraform show`
# output in cleartext (Terraform state itself still contains it — treat state as
# sensitive and keep it in an encrypted backend, e.g. S3 + KMS, not local disk).

resource "random_password" "db" {
  length  = 32
  special = false # avoid characters that need escaping in a connection URL
}

resource "aws_secretsmanager_secret" "db_credentials" {
  name                    = "${var.project_name}-${var.environment}-db-credentials"
  recovery_window_in_days = 0 # demo mode: allow immediate deletion on teardown
}

resource "aws_secretsmanager_secret_version" "db_credentials" {
  secret_id = aws_secretsmanager_secret.db_credentials.id
  secret_string = jsonencode({
    username = var.db_username
    password = random_password.db.result
    host     = aws_db_instance.main.address
    port     = 5432
    dbname   = var.db_name
    # Pre-built so the ECS task can use this one field directly as DATABASE_URL.
    database_url = "postgresql+asyncpg://${var.db_username}:${random_password.db.result}@${aws_db_instance.main.address}:5432/${var.db_name}"
  })
}
