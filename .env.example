# Copy to .env and adjust. No real secrets belong in this file or in .env committed to git.

APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Database ---
DATABASE_URL=postgresql+asyncpg://chronos:chronos@localhost:5432/chronos
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_STATEMENT_TIMEOUT_MS=5000

# --- Queue ---
# "memory" = in-process fake queue (unit tests / quick local dev, single process only)
# "sqs"    = real SQS API, pointed at LocalStack locally or AWS in production
QUEUE_BACKEND=memory
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
SQS_QUEUE_URL=
SQS_DLQ_URL=
SQS_VISIBILITY_TIMEOUT_SECONDS=60
SQS_WAIT_TIME_SECONDS=10
SQS_MAX_MESSAGES_PER_POLL=10

# --- Dispatcher ---
DISPATCH_HORIZON_SECONDS=120
DISPATCH_BATCH_SIZE=500
DISPATCH_POLL_INTERVAL_MS=200
DISPATCH_CONCURRENCY=4
DISPATCHER_ID=dispatcher-1

# --- Outbox publisher ---
OUTBOX_BATCH_SIZE=200
OUTBOX_POLL_INTERVAL_MS=100

# --- Worker ---
WORKER_ID=worker-1
WORKER_CONCURRENCY=8
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
JOB_LEASE_DURATION_SECONDS=90
JOB_DEFAULT_TIMEOUT_SECONDS=30

# --- Retry policy ---
JOB_MAX_RETRIES=5
RETRY_BASE_DELAY_SECONDS=2.0
RETRY_MAX_DELAY_SECONDS=300.0
RETRY_JITTER_SECONDS=1.0

# --- Reconciliation ---
RECONCILIATION_INTERVAL_SECONDS=30
RECONCILIATION_STALE_DISPATCH_SECONDS=60
RECONCILIATION_STALE_RUNNING_SECONDS=180

# --- Payload limits ---
JOB_PAYLOAD_MAX_BYTES=262144

# --- Observability ---
METRICS_PORT=9100

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# --- AWS credentials (never hardcode; use standard SDK credential providers) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
